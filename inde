function normalizeQuery(text){
  return (text||"").toLowerCase().normalize("NFKD")
    .replace(/[“”‘’]/g,"").replace(/[^\p{L}\p{N}\s]/gu," ")
    .replace(/\s+/g," ").trim();
}

function scoreService(query, entry){
  const q=normalizeQuery(query); let score=0;
  for(const term of entry[2]){
    const t=normalizeQuery(term); if(!t) continue;
    if(q===t) score+=100;
    else if(q.includes(t)) score+=48;
    else if(t.includes(q)&&q.length>=3) score+=27;
    const qWords=new Set(q.split(" ")); let common=0;
    for(const w of t.split(" ")) if(w.length>=3&&qWords.has(w)) common++;
    score += common*7;
  }
  if(/\bpassport\b|पासपोर्ट|राहदानी/.test(q)&&entry[1]==="passport")score+=15;
  if(/नागरिकता|citizenship/.test(q)&&entry[1]==="citizenship")score+=15;
  if(/जग्गा|लालपुर्जा|land/.test(q)&&entry[1]==="land")score+=15;
  if(/ठगी|scam|fraud|otp|hack/.test(q)&&entry[1]==="fraud")score+=18;
  if(/विदेश|abroad|japan|korea|qatar|dubai|employment/.test(q)&&entry[1]==="abroad")score+=12;
  return score;
}

function detectIntent(query){
  const q=normalizeQuery(query);
  for(const item of QUERY_INTENT) if(q.includes(item[0])) return item[1];
  return "general";
}
function intentLabel(intent){
