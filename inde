  section.style.display="block";
  if(!ranked.length){
    out.innerHTML='<div class="card notice" style="grid-column:1/-1"><span class="badge">SEARCH</span><h3>We could not find a direct match yet.</h3><p>Try “passport banauna k chaincha?”, “मेरो नागरिकता हरायो”, “NID कसरी बनाउने?”, “jagga ko lalpurja”, or “online fraud bhayo”.</p></div>';
  }else{
    out.innerHTML=ranked.map(({entry,score})=>{
      const d=SERVICES[entry[1]],confidence=score>=65?"Strong match":score>=35?"Likely match":"Related";
      return `<div class="card notice"><span class="badge">${confidence}</span><h3>${d.icon} ${escapeHtml(d.title)}</h3><p>${escapeHtml(d.desc)}</p><div style="margin-top:7px;font-size:10px;color:#98a2b3">Detected intent: ${escapeHtml(intentLabel(intent))}</div><button class="btn red" style="margin-top:9px" onclick="showAnswer('${entry[1]}','${escapeJs(intent)}')">Open best answer</button></div>`;
    }).join("");
  }
  hideSuggestions();section.scrollIntoView({behavior:"smooth",block:"start"});
}

function startVoiceSearch(){
 const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!SR){toast("Voice search is not supported in this browser.");return}
 const r=new SR();r.lang="en-US";r.interimResults=false;r.maxAlternatives=1;
 r.onstart=()=>toast("Listening...");
 r.onresult=e=>{document.getElementById("heroSearch").value=e.results[0][0].transcript;searchSite()};
 r.onerror=()=>toast("Voice search could not start.");r.start();
}


