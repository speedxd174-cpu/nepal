  }
  const ranked=QUERY_MAP.map(entry=>({entry,score:scoreService(q,entry)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score).slice(0,5);
  const exactPopular=POPULAR_QUERIES.filter(x=>normalizeQuery(x[0]).includes(q)||q.includes(normalizeQuery(x[0]))).slice(0,3);
  let items=exactPopular.map(x=>{const d=SERVICES[x[1]];return `<button class="suggestion" onclick="applySearchSuggestion('${escapeJs(x[0])}')"><div class="suggestion-icon">${d.icon}</div><div class="suggestion-main"><b>${escapeHtml(x[0])}</b><span>Popular search</span></div></button>`}).join("");
  items += ranked.map(({entry})=>{const d=SERVICES[entry[1]];return `<button class="suggestion" onclick="openSearchResult('${entry[1]}','${escapeJs(intentLabel(detectIntent(q)))}')"><div class="suggestion-icon">${d.icon}</div><div class="suggestion-main"><b>${escapeHtml(d.title)}</b><span>${escapeHtml(d.desc)}</span></div></button>`}).join("");
