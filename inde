function checkScam(){
 const t=document.getElementById("scamText").value.trim().toLowerCase(),box=document.getElementById("risk");
 if(!t){box.classList.remove("show");return}
 const f=[];
 if(/otp|one[- ]time|verification code/.test(t))f.push("asks for an OTP/verification code");
 if(/pin|password|passcode/.test(t))f.push("asks for a PIN/password");
 if(/send money|pay|processing fee|deposit|transfer|rs\.?|रु/.test(t))f.push("requests money/payment");
 if(/won|winner|prize|lottery|reward|gift/.test(t))f.push("promises an unexpected prize/reward");
 if(/urgent|immediately|now|today|act fast/.test(t))f.push("creates urgency/pressure");
 if(/click|login|verify|account suspended|link/.test(t))f.push("pushes an urgent link/login");
 const risk=f.length>=3?"HIGH":f.length===2?"MEDIUM":"LOW";const cls=risk==="HIGH"?"high":risk==="MEDIUM"?"med":"low";
 box.innerHTML=`<b class="${cls}">Risk: ${risk}</b><br><br>${f.length?f.map(x=>"• "+esc(x)).join("<br>"):"No obvious red flags detected by this basic checker."}<br><br><span style="font-size:10px">This is a simple rule-based tool, not proof of safety. Never share OTPs, PINs or passwords because a message looks convincing.</span>`;
 box.classList.add("show");
}

function addTracker(){
 const type=document.getElementById("trackType").value,service=document.getElementById("trackService").value.trim(),ref=document.getElementById("trackRef").value.trim(),date=document.getElementById("trackDate").value;
 if(!service||!date){toast("Enter service and date.");return}
 trackers.push({id:crypto.randomUUID(),type,service,ref,date,done:false});
 localStorage.setItem("ns_trackers",JSON.stringify(trackers));
 document.getElementById("trackService").value="";document.getElementById("trackRef").value="";document.getElementById("trackDate").value="";
 renderTrackers();toast("Tracker item saved");
}
function renderTrackers(){
 const b=document.getElementById("trackList");
 trackers.sort((a,b)=>a.date.localeCompare(b.date));
 b.innerHTML=trackers.length?trackers.map(x=>`<div class="track"><input type="checkbox" ${x.done?"checked":""} onchange="toggleTracker('${x.id}')"><b>${esc(x.service)}</b><small>${esc(x.type)} • ${esc(x.date)}${x.ref?" • "+esc(x.ref):""}</small><button class="btn gray" onclick="deleteTracker('${x.id}')">×</button></div>`).join(""):`<div class="empty">No tracked items yet.</div>`;
}
function toggleTracker(id){trackers=trackers.map(x=>x.id===id?{...x,done:!x.done}:x);localStorage.setItem("ns_trackers",JSON.stringify(trackers));renderTrackers()}
function deleteTracker(id){trackers=trackers.filter(x=>x.id!==id);localStorage.setItem("ns_trackers",JSON.stringify(trackers));renderTrackers()}
function focusTrack(){document.getElementById("trackerSection").scrollIntoView({behavior:"smooth",block:"center"});document.getElementById("trackService").focus()}

function ageCalc(){const v=document.getElementById("dob").value;if(!v)return;const d=new Date(v+"T00:00:00"),n=new Date();let a=n.getFullYear()-d.getFullYear();const m=n.getMonth()-d.getMonth();if(m<0||(m===0&&n.getDate()<d.getDate()))a--;document.getElementById("ageOut").textContent=`Approx. age: ${a} years`}
function discountCalc(){const p=+document.getElementById("price").value,d=+document.getElementById("disc").value;if(!(p>=0&&d>=0))return;document.getElementById("discOut").textContent=`Save Rs. ${(p*d/100).toFixed(2)} · Final Rs. ${(p-p*d/100).toFixed(2)}`}
function fuelCalc(){const k=+document.getElementById("km").value,m=+document.getElementById("mil").value,p=+document.getElementById("fp").value;if(!(k>0&&m>0&&p>=0))return;document.getElementById("fuelOut").textContent=`Fuel ${(k/m).toFixed(2)} L · Cost Rs. ${(k/m*p).toFixed(2)}`}
function studyCalc(){const h=+document.getElementById("hours").value,s=+document.getElementById("subjects").value;if(!(h>0&&s>0))return;document.getElementById("studyOut").textContent=`About ${(h/s).toFixed(2)} hours per subject`}
function emiCalc(){const P=+document.getElementById("loan").value,R=+document.getElementById("rate").value/1200,N=+document.getElementById("months").value;if(!(P>0&&R>=0&&N>0))return;const emi=R===0?P/N:P*R*Math.pow(1+R,N)/(Math.pow(1+R,N)-1);document.getElementById("emiOut").textContent=`Approx. monthly EMI: Rs. ${emi.toFixed(2)}`}
function percentCalc(){const p=+document.getElementById("part").value,w=+document.getElementById("whole").value;if(!(w>0))return;document.getElementById("percentOut").textContent=`${((p/w)*100).toFixed(2)}%`}
function billCalc(){const b=+document.getElementById("bill").value,n=+document.getElementById("people").value;if(!(b>=0&&n>0))return;document.getElementById("billOut").textContent=`Each person: Rs. ${(b/n).toFixed(2)}`}
function timeCalc(){const d=+document.getElementById("td").value,s=+document.getElementById("ts").value;if(!(d>0&&s>0))return;document.getElementById("timeOut").textContent=`Approx. ${(d/s).toFixed(2)} hours`}

function printAnswer(){const box=document.getElementById("answer");if(!box.classList.contains("show")){toast("Open a guide first.");return}const w=window.open("","_blank");w.document.write(`<html><head><title>NepalSathi Guide</title><style>body{font-family:Arial;padding:30px;color:#222}.actions,.savebar{display:none}.step{padding:10px;border-bottom:1px solid #ddd}.official,.warning{padding:10px;margin-top:12px;border:1px solid #ddd}</style></head><body>${box.innerHTML}</body></html>`);w.document.close();w.print()}
async function shareCurrent(){if(!currentKey){toast("Open a guide first.");return}const d=SERVICES[currentKey];try{if(navigator.share)await navigator.share({title:"NepalSathi — "+d.title,text:d.desc,url:location.href});else{await navigator.clipboard.writeText(location.href);toast("Link copied")}}catch{}}
